$dialog show @s {type:"minecraft:multi_action",body:[{type:"minecraft:plain_message",contents:{text:"Tune the fight, then hit Save.\nTimes are in seconds. HP applies to the next Wither summoned; timings apply the next time that attack triggers.",color:"#FFFFFF"},width:300}],inputs:[{type:"minecraft:number_range",key:"wither_hp",label:{text:"Wither max HP"},start:350,end:2000,step:50,initial:$(wither_hp),width:300},{type:"minecraft:boolean",key:"antiburst",label:{text:"Anti-burst (heal/explode/enrage on huge hits)"},initial:$(antiburst),on_true:"1",on_false:"0"},{type:"minecraft:boolean",key:"blast_enabled",label:{text:"Death blast"},initial:$(blast_enabled),on_true:"1",on_false:"0"},{type:"minecraft:number_range",key:"blast_radius",label:{text:"Death blast radius"},start:5,end:127,step:1,initial:$(blast_radius),width:300},{type:"minecraft:number_range",key:"blast_charge",label:{text:"Death blast charge time (s)"},start:1,end:15,step:1,initial:$(blast_charge),width:300},{type:"minecraft:boolean",key:"enraged_noheal",label:{text:"Enraged: no healing while under attack"},initial:$(enraged_noheal),on_true:"1",on_false:"0"},{type:"minecraft:number_range",key:"heal_delay",label:{text:"Enraged: heal after not hit for (s)"},start:1,end:30,step:1,initial:$(heal_delay),width:300},{type:"minecraft:number_range",key:"charge_cooldown",label:{text:"Charge attack cooldown (s)"},start:5,end:60,step:1,initial:$(charge_cooldown),width:300},{type:"minecraft:number_range",key:"homing_interval",label:{text:"Homing skull every (s)"},start:5,end:60,step:1,initial:$(homing_interval),width:300},{type:"minecraft:number_range",key:"homing_interval_enraged",label:{text:"Homing skull every, enraged (s)"},start:2,end:60,step:1,initial:$(homing_interval_enraged),width:300},{type:"minecraft:boolean",key:"skull_ring",label:{text:"Enraged skull ring"},initial:$(skull_ring),on_true:"1",on_false:"0"},{type:"minecraft:number_range",key:"ring_interval",label:{text:"Skull ring pause between rings (s)"},start:1,end:30,step:1,initial:$(ring_interval),width:300},{type:"minecraft:number_range",key:"spawn_interval",label:{text:"Wither skeleton spawn every (s)"},start:2,end:60,step:1,initial:$(spawn_interval),width:300},{type:"minecraft:number_range",key:"spawn_interval_enraged",label:{text:"Wither skeleton spawn every, enraged (s)"},start:1,end:60,step:1,initial:$(spawn_interval_enraged),width:300},{type:"minecraft:boolean",key:"swarm",label:{text:"Mini skeleton swarm (at 150 HP)"},initial:$(swarm),on_true:"1",on_false:"0"}],can_close_with_escape:1b,after_action:"close",pause:1b,columns:2,exit_action:{label:{translate:"gui.back"},width:200,action:{type:"minecraft:run_command",command:"function wither:dialog/main"}},title:{text:"Fight Tuning",type:"text",bold:1b,color:"#FFFFFF"},actions:[{label:{text:"Save",bold:1b,color:"#13e800"},tooltip:{text:"Save all values above"},width:150,action:{type:"minecraft:dynamic/run_command",template:"$(template)"}},{label:{text:"Reset to defaults",bold:1b,color:"#e80f00"},tooltip:{text:"Put every value on this page back to default"},width:150,action:{type:"minecraft:run_command",command:"function wither:config/reset_tuning"}}]}
